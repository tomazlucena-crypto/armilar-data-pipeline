    {
      "metric_id": "CP09_IMPACT_BP",
      "unit": "BASIS_POINTS",
      "grain": [
        "STRATEGY",
        "ECONOMY",
        "PERIOD"
      ],
      "formula": "contribution_difference_attributable_to_CP09",
      "direction": "REPORT_ABSOLUTE_AND_SIGNED",
