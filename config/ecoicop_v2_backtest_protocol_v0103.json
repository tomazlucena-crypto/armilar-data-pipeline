      "direction": "LOWER_IS_BETTER",
      "required_for_completion": true
    },
    {
      "metric_id": "CATEGORY_RMSE_BP",
      "unit": "BASIS_POINTS",
      "grain": [
        "STRATEGY",
        "CATEGORY",
        "HORIZON"
      ],
      "formula": "root_mean_square(monthly_inflation_difference_bp)",
      "direction": "LOWER_IS_BETTER",
      "required_for_completion": true
    },
    {
      "metric_id": "WORLD_AGGREGATE_RMSE_BP",
      "unit": "BASIS_POINTS",
      "grain": [
        "STRATEGY",
        "HORIZON"
      ],
      "formula": "root_mean_square(world_monthly_inflation_difference_bp)",
      "direction": "LOWER_IS_BETTER",
      "required_for_completion": true
    },
    {
      "metric_id": "LINK_PERIOD_SENSITIVITY_BP",
      "unit": "BASIS_POINTS",
      "grain": [
        "STRATEGY",
        "ECONOMY",
        "CATEGORY"
      ],
      "formula": "max(result_across_allowed_link_periods) - min(result_across_allowed_link_periods)",
      "direction": "LOWER_IS_BETTER",
      "required_for_completion": true
    },
    {
      "metric_id": "CP08_IMPACT_BP",
      "unit": "BASIS_POINTS",
      "grain": [
        "STRATEGY",
        "ECONOMY",
        "PERIOD"
