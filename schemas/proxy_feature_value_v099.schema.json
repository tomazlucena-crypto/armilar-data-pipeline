{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregation_method": {
      "minLength": 1,
      "type": "string"
    },
    "arm_l_use_allowed": {
      "const": "false"
    },
    "component_count": {
      "minimum": 1,
      "type": "integer"
    },
    "component_observation_keys_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "direct_index_use_allowed": {
      "const": "false"
    },
    "feature_age_days": {
      "minimum": 0,
      "type": "integer"
    },
    "feature_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "feature_role": {
      "enum": [
        "PRIMARY_RESEARCH_DRIVER",
        "SENSITIVITY_ONLY"
      ]
    },
    "latest_available_at": {
      "format": "date-time",
      "type": "string"
    },
    "mapping_evidence": {
      "enum": [
        "PARTIAL_COST_DRIVER",
        "SENSITIVITY_ONLY"
      ]
    },
    "mapping_id": {
      "minLength": 1,
      "type": "string"
    },
    "model_training_allowed": {
      "const": "false"
    },
    "native_frequency": {
      "enum": [
        "WEEKLY",
        "MONTHLY",
        "QUARTERLY"
      ]
    },
    "period_completeness_status": {
      "enum": [
        "COMPLETE_PERIOD",
        "PARTIAL_PERIOD_AS_OF_CUTOFF"
      ]
    },
    "series_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_freshness_status": {
      "enum": [
        "CURRENT_WITHIN_EXPECTED_WINDOW",
        "STALE_BEYOND_EXPECTED_WINDOW"
      ]
    },
    "source_geography": {
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_proxy_domain": {
      "minLength": 1,
      "type": "string"
    },
    "target_armilar_category": {
      "pattern": "^ARM0[1-9]$",
      "type": "string"
    },
    "target_category_code": {
      "pattern": "^CP(0[1-9]|1[0-2])$",
      "type": "string"
    },
    "target_economy_code": {
      "pattern": "^[A-Z0-9]{3}$",
      "type": "string"
    },
    "target_frequency": {
      "const": "MONTHLY"
    },
    "target_period": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "type": "string"
    },
    "target_period_end": {
      "format": "date",
      "type": "string"
    },
    "transformation": {
      "enum": [
        "LEVEL",
        "PERIOD_CHANGE_PCT",
        "YEAR_OVER_YEAR_PCT"
      ]
    },
    "unit": {
      "minLength": 1,
      "type": "string"
    },
    "value": {
      "type": "string"
    }
  },
  "required": [
    "feature_id",
    "cutoff",
    "mapping_id",
    "source_id",
    "series_id",
    "source_proxy_domain",
    "source_geography",
    "target_economy_code",
    "target_category_code",
    "target_armilar_category",
    "feature_role",
    "mapping_evidence",
    "native_frequency",
    "target_frequency",
    "target_period",
    "target_period_end",
    "feature_age_days",
    "period_completeness_status",
    "transformation",
    "value",
    "unit",
    "aggregation_method",
    "component_count",
    "component_observation_keys_sha256",
    "latest_available_at",
    "source_freshness_status",
    "direct_index_use_allowed",
    "arm_l_use_allowed",
    "model_training_allowed"
  ],
  "title": "Armilar v0.9.9 feature row",
  "type": "object"
}
