{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARMILAR official engine v0.9.6 observation row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "series_id",
    "economy_code",
    "category_code",
    "period",
    "value",
    "published_at",
    "retrieved_at",
    "vintage_id",
    "revision_sequence",
    "raw_snapshot_id",
    "source_sha256",
    "evidence_class"
  ],
  "properties": {
    "series_id": {"type": "string", "minLength": 1},
    "economy_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "category_code": {"type": "string", "pattern": "^CP(00|0[1-9]|1[0-2])$"},
    "period": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "value": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "published_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|\\+00:00)$"},
    "retrieved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|\\+00:00)$"},
    "vintage_id": {"type": "string", "minLength": 1},
    "revision_sequence": {"type": "integer", "minimum": 0},
    "raw_snapshot_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_class": {"type": "string", "minLength": 1}
  }
}
