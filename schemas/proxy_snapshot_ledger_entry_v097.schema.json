{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ledger_version": {
      "const": "1.0"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "previous_entry_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "snapshot_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "ledger_version",
    "sequence",
    "source_id",
    "snapshot_id",
    "retrieved_at",
    "published_at",
    "source_sha256",
    "registry_sha256",
    "manifest_sha256",
    "previous_entry_hash",
    "entry_hash"
  ],
  "title": "ARMILAR v0.9.7 proxy snapshot ledger entry",
  "type": "object"
}
