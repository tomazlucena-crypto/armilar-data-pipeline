{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armilar.example/schemas/arm_o_materialization_summary_v0101.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "status", "created_at", "policy_id",
    "policy_version", "availability_semantics", "historical_publication_time_claim_allowed",
    "observation_bridge_manifest_sha256", "arm_o_run_id", "arm_o_vintage_id",
    "arm_o_cutoff_at", "arm_o_manifest_sha256", "target_input_view_manifest_sha256",
    "manifest_compatibility_mode", "arm_o_period_count", "arm_o_observation_count",
    "arm_o_replay_status", "ledger_entry_count", "target_archive_manifest_sha256",
    "target_count", "target_cell_count", "target_latest_period", "backtest_overlap_status",
    "research_release_allowed", "backtest_execution_claim_allowed", "model_training_allowed",
    "arm_l_use_allowed", "shadow_production_allowed", "monetary_use_allowed", "gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "0.10.1"},
    "status": {"const": "ARM_O_MATERIALIZATION_AND_TARGET_BRIDGE_VALID"},
    "created_at": {"type": "string"},
    "policy_id": {"const": "ARMILAR_ARM_O_MATERIALIZATION_BRIDGE_V0101"},
    "policy_version": {"const": "0.10.1"},
    "availability_semantics": {"const": "FIRST_VERIFIED_ARMILAR_RETRIEVAL_NOT_OFFICIAL_PUBLICATION_TIME"},
    "historical_publication_time_claim_allowed": {"const": false},
    "observation_bridge_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arm_o_run_id": {"type": "string", "minLength": 1},
    "arm_o_vintage_id": {"type": "string", "minLength": 1},
    "arm_o_cutoff_at": {"type": "string"},
    "arm_o_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_input_view_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_compatibility_mode": {"const": "V096_SINGLE_SPACE_TO_V0100_DOUBLE_SPACE_VIEW_PAYLOAD_BYTES_IDENTICAL"},
    "arm_o_period_count": {"const": 60},
    "arm_o_observation_count": {"const": 3600},
    "arm_o_replay_status": {"type": "string"},
    "ledger_entry_count": {"const": 1},
    "target_archive_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_count": {"const": 6420},
    "target_cell_count": {"const": 60},
    "target_latest_period": {"const": "2025-12"},
    "backtest_overlap_status": {"const": "NO_FUTURE_TARGETS_AFTER_2025_UNTIL_OFFICIAL_ENGINE_PERIOD_IS_EXTENDED"},
    "research_release_allowed": {"const": false},
    "backtest_execution_claim_allowed": {"const": false},
    "model_training_allowed": {"const": false},
    "arm_l_use_allowed": {"const": false},
    "shadow_production_allowed": {"const": false},
    "monetary_use_allowed": {"const": false},
    "gates": {"type": "object"}
  }
}
